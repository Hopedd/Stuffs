{
    "display": {
        "separator": "",
        "color": {
            "keys": "38;2;0;83;192",
            "output": "38;2;0;83;192"
        }
    },
    "logo": {
        "source": "/home/hopedd/.config/fastfetch/DebianBlack.png",
        "type": "kitty",
        "width": 24,
        "height": 12,
        "padding": {
            "left": 3,
            "top": 4,
            "right": 3
        }
    },
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "custom",
            "key": "Hopedd"
        },
        {
            "key": "╭───────────────────────╮",
            "type": "custom"
        },
        {
            "type": "host",
            "key": "│ {#31}",
            "format": ": Hopedd"
        },
        {
            "type": "os",
            "key": "│ {#34}{icon}",
            "format": ": Debian"
        },
        {
            "type": "packages",
            "key": "│ {#38}󰏖",
            "format": ": {all}"
        },
        {
            "type": "uptime",
            "key": "│ {#39}󰅐",
            "format": ": {days}:{hours}:{minutes}:{seconds}:{milliseconds}"
        },
        {
            "type": "de",
            "key": "│ {#36}󰇄",
            "format": ": KDE Plasma"
        },
        {
            "type": "terminal",
            "key": "│ {#31}",
            "format": ": kitty"
        },
        {
            "type": "shell",
            "key": "│ {#32}",
            "format": ": fish"
        },
        {
            "type": "gpu",
            "key": "│ {#34}󰍛",
            "format": ": RX 7600 OC"
        },
        {
            "type": "cpu",
            "key": "│ {#33}󰍛",
            "format": ": Ryzen 7 5800X"
        },
        {
            "type": "memory",
            "key": "│ {#35}",
            "format": ": {used} Used"
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "│ {#34}󰉉",
            "format": ": {size-used} / {size-total}"
        },
        {
            "key": "╰─",
            "type": "custom"
        },
        "break",
        "break"
    ]
}
